#include<iostream>
#include<cstring>
#include<cctype>

using namespace std;

void strip(char (&input)[81]){
  char temp[81] = "";
  int length;
  char ch1;

  length = strlen(input);

  for(int i = 0; i<length; i++){
    ch1 = input[i];
    if(isalnum(ch1)){
      ch1 = toupper(ch1);
      strncat(temp,ch1,1);
    }
  }
  strcpy(input,temp);
}

void getInput(char (&input)[81]){
  cout << "enter command: ";
  cin.get(input);
  strip(input);
  cout(input);
}

int main(){
  char input(81);
  getInput(input);
}
